{
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/ai-catalog.json",
      "destination": "/ai-catalog.json"
    },
    {
      "source": "/((?!api|assets|robots\\.txt|sitemap\\.xml|llms\\.txt|ai-catalog\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
